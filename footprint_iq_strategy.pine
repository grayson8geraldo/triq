// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Footprint IQ Strategy — based on TradingIQ's Footprint IQ Pro
// Добавлены: точки входа/выхода, SL/TP линии, алерты, панель статистики
// Оптимальные параметры найдены через бэктест на 142K+ свечей BTCUSDT (2022-2026)

//@version=6
indicator("Footprint IQ Strategy", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_polylines_count = 100)

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════

enum granularity
    m1 = "1-Minute"
    s1 = "1-Second"
    t1 = "1-Tick"

// --- Footprint Settings ---
grpFP = "Footprint Settings"
gran            = input.enum(defval = granularity.m1, title = "Granularity", group = grpFP)
ticks           = input.float(0, title = "Tick Level Distance (0 = Auto)", group = grpFP)
showDeltaP      = input.bool(defval = true, title = "Show Delta %", group = grpFP)
showTotalVolume = input.bool(defval = true, title = "Show Total Volume", group = grpFP)
showBuyVol      = input.bool(defval = false, title = "Show Buy Volume", group = grpFP)
showSellVol     = input.bool(defval = false, title = "Show Sell Volume", group = grpFP)
useSymbols      = input.bool(defval = true, title = "Use Symbols (δ/⧎/◭/⧩)", group = grpFP)

// --- Imbalance Settings ---
grpIMB = "Imbalances"
imbalanceP      = input.float(defval = 80, minval = 0, maxval = 100, title = "Imbalance %", group = grpIMB)
stacked         = input.int(defval = 3, title = "Stacked Imbalance Count", minval = 2, group = grpIMB)

// --- Value Area ---
grpVA = "Value Area"
vaCumu          = input.float(defval = 70, title = "Value Area %", minval = 0, maxval = 100, group = grpVA) / 100

// --- Strategy Signals (Pullback to Zones) ---
grpSTR = "Strategy — Pullback to Zones"
showSignals     = input.bool(defval = true, title = "Show Entry/Exit Signals", group = grpSTR)
slATRMult       = input.float(defval = 1.8, title = "Stop Loss (ATR behind zone)", minval = 0.1, step = 0.1, group = grpSTR)
tpATRMult       = input.float(defval = 4.0, title = "Take Profit (ATR from entry)", minval = 0.1, step = 0.1, group = grpSTR)
zoneExpiry      = input.int(defval = 36, title = "Zone Expiry (bars)", minval = 1, group = grpSTR)
maxZones        = input.int(defval = 2, title = "Max Active Zones", minval = 1, maxval = 5, group = grpSTR)
showZones       = input.bool(defval = true, title = "Show Support/Resistance Zones", group = grpSTR)
showSLTP        = input.bool(defval = true, title = "Show SL/TP Lines", group = grpSTR)
showPanel       = input.bool(defval = true, title = "Show Info Panel", group = grpSTR)

// --- Colors ---
grpCOL = "Colors"
upCol           = input.color(defval = color.rgb(128, 116, 255), title = "Buy Color", group = grpCOL)
dnCol           = input.color(defval = color.rgb(255, 116, 116), title = "Sell Color", group = grpCOL)
showPOC         = input.bool(defval = true, title = "", inline = "POC", group = grpCOL)
pocCol          = input.color(defval = color.rgb(255, 243, 116), title = "POC Color", inline = "POC", group = grpCOL)
slColor         = input.color(defval = color.rgb(255, 82, 82), title = "SL Line Color", group = grpCOL)
tpColor         = input.color(defval = color.rgb(76, 255, 130), title = "TP Line Color", group = grpCOL)
longColor       = input.color(defval = color.rgb(0, 230, 118), title = "Long Signal Color", group = grpCOL)
shortColor      = input.color(defval = color.rgb(255, 61, 61), title = "Short Signal Color", group = grpCOL)

// ═══════════════════════════════════════════════════════════════
// LOWER TIMEFRAME DATA
// ═══════════════════════════════════════════════════════════════

var tf = switch gran
    granularity.m1  => "1"
    granularity.s1  => "1S"
    granularity.t1  => "1T"

[ltfV, ltfD, ltfC, ltfH, ltfL, ltfBid, ltfAsk, ltfC1] =
     request.security_lower_tf(syminfo.tickerid, tf, [volume, math.sign(close - open), close, high, low, bid, ask, close[1]])

// ═══════════════════════════════════════════════════════════════
// TYPES
// ═══════════════════════════════════════════════════════════════

type footprintData
    array<float> tickLevels
    array<float> deltaArr
    array<float> upVol
    array<float> dnVol
    array<float> totalVol

// ═══════════════════════════════════════════════════════════════
// HELPER METHODS
// ═══════════════════════════════════════════════════════════════

atr = ta.atr(14)

method shiftPopAll(array<float> tickLevels, deltaArr, upVol, dnVol, totalVol, pop = false) =>
    if tickLevels.size() > 90000
        switch pop
            false =>
                  tickLevels.shift(), deltaArr.shift(),
                  upVol     .shift(), dnVol   .shift(),
                          totalVol  .shift()
            =>
                  tickLevels.pop(), deltaArr.pop(),
                  upVol     .pop(), dnVol   .pop(),
                             totalVol  .pop()

method pushUnshiftAll(array<float> tickLevels, deltaArr, upVol, dnVol, totalVol, tickAmount, unshift = false) =>
    switch unshift
        false => tickLevels.push(tickAmount),
                 deltaArr.push(0), upVol.push(0), dnVol.push(0), totalVol.push(0)
        =>       tickLevels.unshift(tickAmount),
                 deltaArr.unshift(0), upVol.unshift(0), dnVol.unshift(0), totalVol.unshift(0)

method fillAll(array<float> deltaArr, upVol, dnVol, totalVol) =>
    if gran != granularity.t1
        if timeframe.change("")
            if deltaArr.size() > 0
                deltaArr.fill(0), upVol.fill(0), dnVol.fill(0), totalVol.fill(0)
    else
        if deltaArr.size() > 0
            deltaArr.fill(0), upVol.fill(0), dnVol.fill(0), totalVol.fill(0)

// ═══════════════════════════════════════════════════════════════
// STRATEGY STATE VARIABLES
// ═══════════════════════════════════════════════════════════════

var int   posDirection  = 0       // 0=flat, 1=long, -1=short
var float entryPrice    = na
var float slPrice       = na
var float tpPrice       = na
var int   entryBar      = na
var int   totalTrades   = 0
var int   totalWins     = 0
var int   totalLosses   = 0
var float totalPnlPct   = 0.0
var line  slLine        = na
var line  tpLine        = na
var line  entryLine     = na

// Активные зоны (pullback targets)
// Массивы: low, high, direction (1=support, -1=resistance), creation bar, box
var zLow  = array.new<float>()
var zHigh = array.new<float>()
var zDir  = array.new<int>()
var zBar  = array.new<int>()
var zBox  = array.new<box>()

// ═══════════════════════════════════════════════════════════════
// MAIN FOOTPRINT LOGIC + STRATEGY
// ═══════════════════════════════════════════════════════════════

// Переменные сигналов (для plotshape — нужны на каждом баре)
var bool longSignal  = false
var bool shortSignal = false
var bool tpHit       = false
var bool slHit       = false

longSignal  := false
shortSignal := false
tpHit       := false
slHit       := false

if ltfV.size() > 0

    var FD = footprintData.new(array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>())

    var tickAmount = 0.

    FD.deltaArr.fillAll(FD.upVol, FD.dnVol, FD.totalVol)

    cond = switch gran == granularity.t1
        false => timeframe.change("1D")
        =>       ltfV.size() > 0 and na(ltfV.size()[1]) or timeframe.change("1D")

    if cond
        tickAmount := switch ticks == 0
            true => atr * syminfo.mintick
            =>      ticks * syminfo.mintick

        FD.tickLevels     := array.from(open - tickAmount, open, open + tickAmount)
        FD.deltaArr       := array.from(0, 0, 0), FD.upVol      := array.from(0, 0, 0)
        FD.dnVol          := array.from(0, 0, 0), FD.totalVol   := array.from(0, 0, 0)

    if FD.tickLevels.size() > 0

        last  = FD.tickLevels.last()
        first = FD.tickLevels.first()

        while high >= last
            last += tickAmount
            FD.tickLevels.pushUnshiftAll(FD.deltaArr, FD.upVol, FD.dnVol, FD.totalVol, last)
            FD.tickLevels.shiftPopAll   (FD.deltaArr, FD.upVol, FD.dnVol, FD.totalVol)

        while low <= first
            first -= tickAmount
            FD.tickLevels.pushUnshiftAll(FD.deltaArr, FD.upVol, FD.dnVol, FD.totalVol, first, true)
            FD.tickLevels.shiftPopAll   (FD.deltaArr, FD.upVol, FD.dnVol, FD.totalVol, true)

        // --- Distribute LTF volume to tick levels ---
        if gran != granularity.t1
            for i = 0 to ltfV.size() - 1
                getVol = ltfV.get(i)
                getHigh = ltfH.get(i)
                getLow = ltfL.get(i)
                getTop = FD.tickLevels.binary_search_leftmost(getHigh)
                getBot = FD.tickLevels.binary_search_leftmost(getLow)

                if ltfD.get(i) == -1
                    getVol *= -1

                div = getVol / (getTop - getBot + 1)
                for x = getBot to getTop
                    FD.deltaArr.set(x, FD.deltaArr.get(x) + div)
                    switch math.sign(getVol)
                        1  => FD.upVol.set(x, FD.upVol.get(x) + div)
                        -1 => FD.dnVol.set(x, FD.dnVol.get(x) + div)
                    FD.totalVol.set(x, FD.totalVol.get(x) + math.abs(div))

        if gran == granularity.t1
            for i = 0 to ltfV.size() - 1
                getVol = ltfV.get(i)
                getHigh = ltfH.get(i)
                getLow = ltfL.get(i)
                getBid = ltfBid.get(i)
                getAsk = ltfAsk.get(i)
                getClose = ltfC.get(i)
                getCloseP = ltfC1.get(i)
                getTop = FD.tickLevels.binary_search_leftmost(getHigh)
                getBot = FD.tickLevels.binary_search_leftmost(getLow)

                getVol *= switch
                    getClose <= getBid   => -1
                    getClose >= getAsk   => 1
                    getClose > getCloseP => 1
                    getClose < getCloseP => -1
                    => 0

                div = getVol / (getTop - getBot + 1)
                for x = getBot to getTop
                    FD.deltaArr.set(x, FD.deltaArr.get(x) + div)
                    switch math.sign(getVol)
                        1  => FD.upVol.set(x, FD.upVol.get(x) + div)
                        -1 => FD.dnVol.set(x, FD.dnVol.get(x) + div)
                    FD.totalVol.set(x, FD.totalVol.get(x) + math.abs(div))

        // ═══════════════════════════════════════════════════════════
        // RENDER FOOTPRINT BOXES + DETECT IMBALANCES
        // ═══════════════════════════════════════════════════════════

        getStart = FD.tickLevels.binary_search_leftmost(low)
        getEnd   = FD.tickLevels.binary_search_leftmost(high)
        getLevelsSize = FD.tickLevels.size()

        posVals = array.new<float>()
        negVals = array.new<float>()
        for data in FD.deltaArr
            switch
                data > 0 => posVals.push(data)
                data < 0 => negVals.push(data)

        minGrad = math.min(nz(posVals.min()), nz(math.abs(negVals.max())))
        maxGrad = math.max(nz(posVals.max()), nz(math.abs(negVals.min())))

        // --- Stacked imbalance detection ---
        stackBuyCount  = 0
        stackSellCount = 0
        maxBuyStack    = 0
        maxSellStack   = 0

        imbalanceLab = array.new<label>()
        var finalLevel = float(na)
        levelsBox = array.new<box>()

        // --- Для POC и VA ---
        sliceStart = getStart
        sliceEnd   = getEnd

        // --- Total delta для стратегии ---
        totalDelta = 0.0

        for i = getStart to getEnd
            getLevel = FD.tickLevels.get(i)
            getLevelNext = switch i + 1 == getLevelsSize
                false => FD.tickLevels.get(i + 1)
                =>       getLevel + tickAmount

            getDelta    = FD.deltaArr.get(i)
            getTotalVol = FD.totalVol.get(i)
            getDeltaP   = getTotalVol > 0 ? getDelta / getTotalVol * 100 : 0.0
            totalDelta += getDelta

            finalLevel := getLevelNext

            gradient = switch math.sign(getDelta)
                1 => color.from_gradient(getDelta, minGrad, maxGrad, color.new(upCol, 70), color.new(upCol, 10))
                =>   color.from_gradient(getDelta, -maxGrad, -minGrad, color.new(dnCol, 10), color.new(dnCol, 70))

            if showPOC
                if getDelta == maxGrad or getDelta == -maxGrad
                    gradient := color.new(pocCol, 40)

            // --- Text ---
            txtValues = ""
            textArr = switch useSymbols
                true => array.from("δ: ", "\nδ%: ", "\n⧎: ", "\n◭: ", "\n⧩: ")
                =>      array.from("Delta: ", "\nDelta%: ", "\nVol: ", "\nBuy: ", "\nSell: ")
            addArr = array.from(true, showDeltaP, showTotalVolume, showBuyVol, showSellVol)
            valuesArr = array.from(
                 str.tostring(getDelta, format.volume),
                 str.tostring(getDeltaP, format.percent),
                 str.tostring(FD.totalVol.get(i), format.volume),
                 str.tostring(FD.upVol.get(i), format.volume),
                 str.tostring(FD.dnVol.get(i), format.volume))

            for [x, data] in valuesArr
                if addArr.get(x)
                    txtValues += textArr.get(x) + data

            levelsBox.push(box.new(bar_index, getLevel, bar_index + 1, getLevelNext,
                 border_color = chart.bg_color, border_width = 4, bgcolor = gradient,
                 text = txtValues))

            // --- Imbalance detection ---
            // Пустые уровни пропускаем (не ломаем стек) — как в Python бэктесте
            if getTotalVol > 0
                if math.abs(getDeltaP) >= imbalanceP
                    getSign = math.sign(getDeltaP)
                    if getSign == 1
                        stackBuyCount  += 1
                        stackSellCount := 0
                        maxBuyStack    := math.max(maxBuyStack, stackBuyCount)
                    else
                        stackSellCount += 1
                        stackBuyCount  := 0
                        maxSellStack   := math.max(maxSellStack, stackSellCount)

                    [imbColor, txt] = switch getSign
                        1 => [upCol, "𝅉"]
                        =>   [dnCol, "𝅏"]

                    imbalanceLab.push(label.new(bar_index + 1, math.avg(getLevel, getLevelNext),
                         textcolor = chart.fg_color,
                         text = txt, size = size.normal,
                         color = #00000000, style = label.style_label_center,
                         tooltip = str.tostring(getDeltaP, format.percent) + " Imbalance"))

                    if stackBuyCount == stacked or stackSellCount == stacked
                        for x = 0 to imbalanceLab.size() - 1
                            imbalanceLab.get(x).set_textcolor(color.rgb(255, 243, 116))
                    else if stackBuyCount > stacked or stackSellCount > stacked
                        imbalanceLab.last().set_textcolor(color.rgb(255, 243, 116))
                else
                    // Уровень с объёмом, но без imbalance — сброс стека
                    stackBuyCount  := 0
                    stackSellCount := 0
                    imbalanceLab.clear()
            // getTotalVol == 0 → пустой уровень, НЕ сбрасываем стек (continue)

        // ═══════════════════════════════════════════════════════════
        // POC & VALUE AREA
        // ═══════════════════════════════════════════════════════════

        sliceVol    = FD.totalVol.slice(getStart, getEnd + 1)
        sliceVolMax = sliceVol.max()
        newPoc      = sliceVol.indexof(sliceVolMax)
        sliceLevels = FD.tickLevels.slice(getStart, getEnd + 1)
        sumVol      = sliceVol.sum()
        arrSize     = sliceVol.size()

        pocPrice   = sliceLevels.get(newPoc)
        vaLowPrice  = pocPrice
        vaHighPrice = pocPrice

        for x = 0 to arrSize - 1
            slice = sliceVol.slice(math.max(newPoc - x, 0), math.min(newPoc + x + 1, arrSize))
            if slice.sum() / sumVol >= vaCumu
                bottom = math.max(newPoc - x, 0)
                top    = math.min(newPoc + x + 1, arrSize - 1)
                vaLowPrice  := sliceLevels.get(bottom)
                vaHighPrice := sliceLevels.get(top)

                label.new(bar_index, vaLowPrice, "🞂", color = #00000000, size = size.small,
                     style = label.style_label_center, textcolor = color.white)

                if levelsBox.size() > 0
                    for data in levelsBox
                        if data.get_bottom() >= vaLowPrice and data.get_top() <= vaHighPrice
                            data.set_border_width(4)
                break

        // --- Summary box ---
        txtValues = ""
        textArr = switch useSymbols
            true => array.from("δ: ", "\nδ%: ", "\n⧎: ", "\n◭: ", "\n⧩: ")
            =>      array.from("Delta: ", "\nDelta%: ", "\nVol: ", "\nBuy: ", "\nSell: ")
        addArr = array.from(true, showDeltaP, showTotalVolume, showBuyVol, showSellVol)
        getDeltaP_total = volume > 0 ? totalDelta / volume * 100 : 0
        valuesArr = array.from(
             str.tostring(totalDelta, format.volume),
             str.tostring(getDeltaP_total, format.percent),
             str.tostring(volume, format.volume),
             str.tostring(FD.upVol.sum(), format.volume),
             str.tostring(FD.dnVol.sum(), format.volume))
        for [x, data] in valuesArr
            if addArr.get(x)
                txtValues += textArr.get(x) + data
        box.new(bar_index, finalLevel, bar_index + 1, finalLevel + tickAmount,
             border_color = #00000000, bgcolor = #00000000, text = txtValues)

        // ═══════════════════════════════════════════════════════════
        // PULLBACK TO ZONES STRATEGY
        // 1. Stacked imbalances → создаём зону S/R (на VA boundary)
        // 2. Ждём откат цены к зоне
        // 3. Если цена коснулась зоны и закрылась обратно → вход
        // ═══════════════════════════════════════════════════════════

        if showSignals

            hasStackedBuy  = maxBuyStack  >= stacked
            hasStackedSell = maxSellStack >= stacked

            // ── 1. Удаляем просроченные зоны ──
            if zLow.size() > 0
                for i = zLow.size() - 1 to 0
                    if bar_index - zBar.get(i) > zoneExpiry
                        zLow.remove(i), zHigh.remove(i), zDir.remove(i), zBar.remove(i)
                        b = zBox.get(i)
                        if not na(b)
                            b.set_right(bar_index)
                        zBox.remove(i)

            // ── 2. Проверяем SL/TP ──
            if posDirection == 1
                if low <= slPrice
                    slHit := true
                    posDirection := 0
                    totalTrades += 1
                    totalLosses += 1
                    totalPnlPct += (slPrice - entryPrice) / entryPrice * 100
                else if high >= tpPrice
                    tpHit := true
                    posDirection := 0
                    totalTrades += 1
                    totalWins   += 1
                    totalPnlPct += (tpPrice - entryPrice) / entryPrice * 100

            else if posDirection == -1
                if high >= slPrice
                    slHit := true
                    posDirection := 0
                    totalTrades += 1
                    totalLosses += 1
                    totalPnlPct += (entryPrice - slPrice) / entryPrice * 100
                else if low <= tpPrice
                    tpHit := true
                    posDirection := 0
                    totalTrades += 1
                    totalWins   += 1
                    totalPnlPct += (entryPrice - tpPrice) / entryPrice * 100

            if posDirection == 0
                if not na(slLine)
                    slLine.set_x2(bar_index)
                if not na(tpLine)
                    tpLine.set_x2(bar_index)
                if not na(entryLine)
                    entryLine.set_x2(bar_index)

            // ── 3. Проверяем откат к зонам → ВХОД ──
            if posDirection == 0 and zLow.size() > 0
                for i = 0 to zLow.size() - 1
                    if i >= zLow.size()
                        break

                    zl = zLow.get(i), zh = zHigh.get(i), zd = zDir.get(i)

                    // LONG: цена дошла до зоны поддержки и закрылась выше
                    if zd == 1 and low <= zh and close > zh and posDirection == 0
                        longSignal   := true
                        posDirection := 1
                        entryPrice   := close
                        slPrice      := zl - slATRMult * atr
                        tpPrice      := close + tpATRMult * atr
                        entryBar     := bar_index

                        if showSLTP
                            slLine    := line.new(bar_index, slPrice, bar_index + 20, slPrice,
                                             color = slColor, style = line.style_dashed, width = 2)
                            tpLine    := line.new(bar_index, tpPrice, bar_index + 20, tpPrice,
                                             color = tpColor, style = line.style_dashed, width = 2)
                            entryLine := line.new(bar_index, entryPrice, bar_index + 20, entryPrice,
                                             color = longColor, style = line.style_solid, width = 1)

                        label.new(bar_index, low - atr * 0.3,
                             text = "► LONG\n@ " + str.tostring(entryPrice, format.mintick) +
                                    "\nSL: " + str.tostring(slPrice, format.mintick) +
                                    "\nTP: " + str.tostring(tpPrice, format.mintick),
                             color = longColor, textcolor = color.white,
                             style = label.style_label_up, size = size.small)

                        // Убираем отработанную зону
                        zLow.remove(i), zHigh.remove(i), zDir.remove(i), zBar.remove(i)
                        zBox.get(i).set_right(bar_index)
                        zBox.remove(i)
                        break

                    // SHORT: цена дошла до зоны сопротивления и закрылась ниже
                    if zd == -1 and high >= zl and close < zl and posDirection == 0
                        shortSignal  := true
                        posDirection := -1
                        entryPrice   := close
                        slPrice      := zh + slATRMult * atr
                        tpPrice      := close - tpATRMult * atr
                        entryBar     := bar_index

                        if showSLTP
                            slLine    := line.new(bar_index, slPrice, bar_index + 20, slPrice,
                                             color = slColor, style = line.style_dashed, width = 2)
                            tpLine    := line.new(bar_index, tpPrice, bar_index + 20, tpPrice,
                                             color = tpColor, style = line.style_dashed, width = 2)
                            entryLine := line.new(bar_index, entryPrice, bar_index + 20, entryPrice,
                                             color = shortColor, style = line.style_solid, width = 1)

                        label.new(bar_index, high + atr * 0.3,
                             text = "► SHORT\n@ " + str.tostring(entryPrice, format.mintick) +
                                    "\nSL: " + str.tostring(slPrice, format.mintick) +
                                    "\nTP: " + str.tostring(tpPrice, format.mintick),
                             color = shortColor, textcolor = color.white,
                             style = label.style_label_down, size = size.small)

                        zLow.remove(i), zHigh.remove(i), zDir.remove(i), zBar.remove(i)
                        zBox.get(i).set_right(bar_index)
                        zBox.remove(i)
                        break

            // ── 4. Создаём новые зоны из stacked imbalances ──
            if hasStackedBuy and totalDelta > 0
                zWidth = tickAmount * 2
                supportLow  = vaLowPrice - zWidth
                supportHigh = vaLowPrice + zWidth

                // Ограничиваем количество зон
                supportCount = 0
                for i = 0 to zDir.size() - 1
                    if zDir.get(i) == 1
                        supportCount += 1
                if supportCount < maxZones
                    zLow.push(supportLow), zHigh.push(supportHigh)
                    zDir.push(1), zBar.push(bar_index)
                    if showZones
                        zBox.push(box.new(bar_index, supportLow, bar_index + zoneExpiry, supportHigh,
                             bgcolor = color.new(longColor, 85), border_color = color.new(longColor, 50),
                             border_width = 1, text = "Support", text_color = longColor, text_size = size.tiny))
                    else
                        zBox.push(box(na))

            if hasStackedSell and totalDelta < 0
                zWidth = tickAmount * 2
                resistLow  = vaHighPrice - zWidth
                resistHigh = vaHighPrice + zWidth

                resistCount = 0
                for i = 0 to zDir.size() - 1
                    if zDir.get(i) == -1
                        resistCount += 1
                if resistCount < maxZones
                    zLow.push(resistLow), zHigh.push(resistHigh)
                    zDir.push(-1), zBar.push(bar_index)
                    if showZones
                        zBox.push(box.new(bar_index, resistLow, bar_index + zoneExpiry, resistHigh,
                             bgcolor = color.new(shortColor, 85), border_color = color.new(shortColor, 50),
                             border_width = 1, text = "Resistance", text_color = shortColor, text_size = size.tiny))
                    else
                        zBox.push(box(na))

            // --- Продлеваем SL/TP линии ---
            if posDirection != 0 and showSLTP
                if not na(slLine)
                    slLine.set_x2(bar_index + 5)
                if not na(tpLine)
                    tpLine.set_x2(bar_index + 5)
                if not na(entryLine)
                    entryLine.set_x2(bar_index + 5)

// ═══════════════════════════════════════════════════════════════
// SIGNAL MARKERS (plotshape)
// ═══════════════════════════════════════════════════════════════

plotshape(longSignal,  title = "Long Entry",  style = shape.triangleup,   location = location.belowbar,
     color = longColor,  size = size.normal, text = "▲ LONG")
plotshape(shortSignal, title = "Short Entry", style = shape.triangledown, location = location.abovebar,
     color = shortColor, size = size.normal, text = "▼ SHORT")
plotshape(tpHit,       title = "Take Profit", style = shape.xcross,       location = location.abovebar,
     color = tpColor,    size = size.small,  text = "TP")
plotshape(slHit,       title = "Stop Loss",   style = shape.xcross,       location = location.belowbar,
     color = slColor,    size = size.small,  text = "SL")

// ═══════════════════════════════════════════════════════════════
// INFO PANEL (table)
// ═══════════════════════════════════════════════════════════════

if showPanel and barstate.islast
    var table panel = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 30),
         border_width = 1, border_color = color.gray)

    winRate = totalTrades > 0 ? totalWins / totalTrades * 100 : 0.0

    posText  = switch posDirection
        1  => "LONG"
        -1 => "SHORT"
        =>    "FLAT"
    posColor = switch posDirection
        1  => longColor
        -1 => shortColor
        =>    color.gray

    table.cell(panel, 0, 0, "Footprint IQ Pullback", text_color = color.white, text_size = size.normal, bgcolor = color.new(color.blue, 60))
    table.cell(panel, 1, 0, "Zones: " + str.tostring(zLow.size()), text_color = color.white, text_size = size.small, bgcolor = color.new(color.blue, 60))

    table.cell(panel, 0, 1, "Position",     text_color = color.gray,  text_size = size.small)
    table.cell(panel, 1, 1, posText,         text_color = posColor,    text_size = size.small)

    table.cell(panel, 0, 2, "Entry Price",  text_color = color.gray,  text_size = size.small)
    table.cell(panel, 1, 2, posDirection != 0 ? str.tostring(entryPrice, format.mintick) : "—",
         text_color = color.white, text_size = size.small)

    table.cell(panel, 0, 3, "Stop Loss",    text_color = color.gray,  text_size = size.small)
    table.cell(panel, 1, 3, posDirection != 0 ? str.tostring(slPrice, format.mintick) : "—",
         text_color = slColor,    text_size = size.small)

    table.cell(panel, 0, 4, "Take Profit",  text_color = color.gray,  text_size = size.small)
    table.cell(panel, 1, 4, posDirection != 0 ? str.tostring(tpPrice, format.mintick) : "—",
         text_color = tpColor,    text_size = size.small)

    table.cell(panel, 0, 5, "Total Trades", text_color = color.gray,  text_size = size.small)
    table.cell(panel, 1, 5, str.tostring(totalTrades),
         text_color = color.white, text_size = size.small)

    table.cell(panel, 0, 6, "Win Rate",     text_color = color.gray,  text_size = size.small)
    table.cell(panel, 1, 6, str.tostring(winRate, "#.#") + "%",
         text_color = winRate >= 24 ? tpColor : slColor, text_size = size.small)

    table.cell(panel, 0, 7, "Total P&L %",  text_color = color.gray,  text_size = size.small)
    table.cell(panel, 1, 7, str.tostring(totalPnlPct, "#.##") + "%",
         text_color = totalPnlPct >= 0 ? tpColor : slColor, text_size = size.small)

// ═══════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════

// Алерт на откат к зоне (вход)
alertcondition(longSignal,  title = "Long — Pullback to Support",  message = "Footprint IQ: LONG — price pulled back to support zone. Entry: {{close}}")
alertcondition(shortSignal, title = "Short — Pullback to Resistance", message = "Footprint IQ: SHORT — price pulled back to resistance zone. Entry: {{close}}")
alertcondition(tpHit,       title = "Take Profit Hit",      message = "Footprint IQ: TP reached!")
alertcondition(slHit,       title = "Stop Loss Hit",        message = "Footprint IQ: SL hit!")
alertcondition(longSignal or shortSignal, title = "Any Pullback Entry", message = "Footprint IQ: Pullback entry at {{close}}")
